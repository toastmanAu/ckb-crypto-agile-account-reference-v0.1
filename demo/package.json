{
  "name": "ckb-passkey-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:fixture": "concurrently -k -n fixture,web \"tsx test/fixtures/mock-server.ts\" \"npm:dev:fixture:client\"",
    "dev:fixture:client": "CKB_PASSKEY_BROWSER_FIXTURE=1 VITE_CKB_RPC_URL=http://localhost:5173/__test__/rpc vite --host 127.0.0.1 --port 5173 --strictPort",
    "test": "vitest run",
    "test:browser": "playwright test test/browser/demo.spec.ts",
    "test:testnet": "CKB_PASSKEY_REAL_TESTNET_SPEC=1 playwright test test/browser/real-testnet.spec.ts",
    "testnet:archive": "tsx test/support/archive-real-testnet.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "vite build",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "check": "npm run typecheck && npm test && npm run test:browser && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "@ckb-ccc/core": "1.18.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "22.18.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
