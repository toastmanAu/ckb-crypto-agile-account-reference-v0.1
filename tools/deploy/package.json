    "deploy": "tsx src/deploy.ts",
    "bootstrap": "tsx src/bootstrap.ts"
  },
  "dependencies": {
    "@ckb-ccc/core": "1.18.2"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
