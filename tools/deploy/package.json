{
  "name": "ckb-account-deploy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Code-cell deployment tooling for the CKB crypto-agile account reference. Not part of the Rust workspace and not required by scripts/check.sh.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
